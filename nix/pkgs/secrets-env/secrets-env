#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["typer", "pydantic", "pydantic-settings", "python-dotenv"]
# ///
"""Resolve NAME=<source> lines (default .env.secrets) into shell exports.

    DB_PASSWORD=ksm:keeper://<record-uid>/field/password   Keeper Secrets Manager (KSM_CONFIG_FILE, else ksm's profile)
    API_TOKEN=keeper:<record-uid>                          Keeper Commander (persistent login), password field
    JIRA_TOKEN=keeper:<record-uid>#note                    ... or a field by type or label, notes, or file (its one attachment)
    GH_TOKEN=rbw:github                                    Bitwarden via rbw: password, or rbw:<entry>#<field>
    N8N_KEY=sops:secrets.yaml#integrations/n8n/key         sops file, key path split on /
    SMTP_PASS=age:secrets/smtp.age                         age/agenix file ($AGE_IDENTITY, default ~/.ssh/id_ed25519)
    JIRA_TOKEN=file:/run/user/1000/secrets/JIRA_API_TOKEN  any decrypted file, e.g. sops-nix or agenix paths

Relative paths resolve against the current directory. Vault CLIs come from
PATH and get no stdin, so a locked vault fails instead of prompting: unlock it
first (rbw unlock, keeper login). Prints nothing unless every secret resolved.
"""

import base64
import json
import os
import shlex
import subprocess
import tempfile
from pathlib import Path
from typing import Annotated, Literal

import typer
from dotenv import dotenv_values
from pydantic import BaseModel, Field
from pydantic_settings import BaseSettings


class Settings(BaseSettings):
    age_identity: Path = Path.home() / ".ssh/id_ed25519"
    ksm_config_file: Path | None = None
    xdg_runtime_dir: Path = Path(tempfile.gettempdir())


class Source(BaseModel):
    name: str = Field(pattern=r"^[A-Za-z_][A-Za-z0-9_]*$")
    scheme: Literal["ksm", "keeper", "rbw", "sops", "age", "file"]
    ref: str

    @classmethod
    def parse(cls, name: str, value: str) -> "Source":
        scheme, _, ref = value.partition(":")
        return cls(name=name, scheme=scheme, ref=ref)


settings = Settings()


def run(*args: str, env: dict[str, str] | None = None) -> str:
    """Run a vault CLI without stdin; its output minus trailing newlines, like $(...)."""
    out = subprocess.run(args, stdin=subprocess.DEVNULL, capture_output=True, text=True, check=True, env=env)
    return out.stdout.rstrip("\n")


def split_field(ref: str, default: str = "") -> tuple[str, str]:
    item, _, field = ref.partition("#")
    return item, field or default


def keeper(ref: str) -> str:
    uid, field = split_field(ref, "password")
    if field == "password":
        return run("keeper", "get", uid, "--format", "password")
    if field == "file":
        with tempfile.TemporaryDirectory(dir=settings.xdg_runtime_dir) as tmp:
            run("keeper", "download-attachment", uid, "--out-dir", tmp)
            [attachment] = Path(tmp).iterdir()  # exactly one attachment
            return attachment.read_text()
    record = json.loads(run("keeper", "get", uid, "--format", "json", "--unmask"))
    if field == "notes":
        return record["notes"]
    fields = record.get("fields", []) + record.get("custom", [])
    return next(f["value"][0] for f in fields if field in (f.get("type"), f.get("label")))


def rbw(ref: str) -> str:
    entry, field = split_field(ref)
    return run("rbw", "get", *(["--field", field] if field else []), entry)


def sops(ref: str) -> str:
    file, key = split_field(ref)
    return run("sops", "decrypt", "--extract", "".join(f'["{k}"]' for k in key.split("/")), file)


def age(ref: str) -> str:
    return run("age", "--decrypt", "--identity", str(settings.age_identity), ref)


def file(ref: str) -> str:
    return Path(ref).read_text().rstrip("\n")


RESOLVERS = {"keeper": keeper, "rbw": rbw, "sops": sops, "age": age, "file": file}


def ksm(sources: list[Source], values: dict[str, str]) -> dict[str, str]:
    """One `ksm exec` for every ksm: line: it swaps keeper:// values in its env for secrets."""
    env = {s.name: s.ref for s in sources}
    # The ksm CLI reads a base64 config from KSM_CONFIG. A KSM_CONFIG line in
    # the same file (e.g. keeper:<uid>#file) bootstraps it.
    if "KSM_CONFIG" in values:
        env["KSM_CONFIG"] = values["KSM_CONFIG"]
    elif settings.ksm_config_file and settings.ksm_config_file.is_file():
        env["KSM_CONFIG"] = base64.b64encode(settings.ksm_config_file.read_bytes()).decode()
    output = run("ksm", "exec", "--", "env", "-0", env={**os.environ, **env})
    resolved = dict(pair.split("=", 1) for pair in output.split("\0") if "=" in pair)
    for s in sources:
        if resolved.get(s.name, s.ref).startswith("keeper://"):
            raise ValueError(f"ksm did not resolve {s.ref}")
    return {s.name: resolved[s.name] for s in sources}


def resolve(path: Path) -> dict[str, str]:
    sources = [Source.parse(name, value or "") for name, value in dotenv_values(path, interpolate=False).items()]
    values: dict[str, str] = {}
    for s in sources:
        if s.scheme != "ksm":
            try:
                values[s.name] = RESOLVERS[s.scheme](s.ref)
            except Exception as e:
                raise typer.Exit(f"secrets-env: {s.name}: cannot read {s.scheme}:{s.ref} ({e})") from e
    if ksm_sources := [s for s in sources if s.scheme == "ksm"]:
        try:
            values |= ksm(ksm_sources, values)
        except Exception as e:
            raise typer.Exit(f"secrets-env: ksm failed ({e})") from e
    return {s.name: values[s.name] for s in sources}


def main(
    file: Annotated[Path, typer.Argument(exists=True, dir_okay=False)] = Path(".env.secrets"),
    as_json: Annotated[bool, typer.Option("--json", help="Print a JSON object instead of exports.")] = False,
) -> None:
    values = resolve(file)
    if as_json:
        print(json.dumps(values))
    else:
        print("\n".join(f"export {name}={shlex.quote(value)}" for name, value in values.items()))


if __name__ == "__main__":
    typer.run(main)
