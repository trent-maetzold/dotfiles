@@ -0,0 +1,91 @@
+package create
+
+import (
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/ankitpokhrel/jira-cli/internal/cmdutil"
+	"github.com/ankitpokhrel/jira-cli/pkg/jira"
+	"github.com/spf13/viper"
+)
+
+// Sub-tasks inherit their parent's epic and sprint.
+func (cc *createCmd) validateEpic(noEpic bool, projectType, epicField string) (bool, error) {
+	if strings.EqualFold(cc.params.IssueType, jira.IssueTypeEpic) {
+		return false, fmt.Errorf("use jira epic create to create an epic")
+	}
+	var issueType *jira.IssueType
+	for _, t := range cc.issueTypes {
+		if strings.EqualFold(t.Name, cc.params.IssueType) || (t.Handle != "" && strings.EqualFold(t.Handle, cc.params.IssueType)) {
+			issueType = t
+			break
+		}
+	}
+	if issueType == nil {
+		return false, fmt.Errorf("unknown issue type %q", cc.params.IssueType)
+	}
+	cc.params.ParentIssueKey = strings.TrimSpace(cc.params.ParentIssueKey)
+	if cc.params.ParentIssueKey == "" && (issueType.Subtask || !noEpic) {
+		return false, fmt.Errorf("--parent is required; use --no-epic only for an ordinary issue without an epic")
+	}
+	if !issueType.Subtask && noEpic && cc.params.ParentIssueKey != "" {
+		return false, fmt.Errorf("--parent and --no-epic cannot be combined for an ordinary issue")
+	}
+	if cc.params.ParentIssueKey != "" && !noEpic && projectType != jira.ProjectTypeNextGen && strings.TrimSpace(epicField) == "" {
+		return false, fmt.Errorf("configure epic.link before creating an issue with an epic")
+	}
+	if cc.params.ParentIssueKey != "" {
+		cc.params.ParentIssueKey = cmdutil.GetJiraIssueKey(viper.GetString("project.key"), cc.params.ParentIssueKey)
+	}
+	return issueType.Subtask, nil
+}
+
+func (cc *createCmd) validateSubtask(sprintID int, noEpic bool) error {
+	jql := fmt.Sprintf("key = %q AND sprint = %d", cc.params.ParentIssueKey, sprintID)
+	if !noEpic {
+		field := strings.TrimPrefix(viper.GetString("epic.link"), "customfield_")
+		jql += fmt.Sprintf(" AND cf[%s] is not EMPTY", field)
+	}
+	parents, err := cc.client.SearchV2(jql, 0, 1)
+	if err != nil {
+		return fmt.Errorf("check sub-task parent: %w", err)
+	}
+	if len(parents.Issues) != 1 {
+		return fmt.Errorf("sub-task parent must belong to the current Risk sprint and have an epic (or pass --no-epic)")
+	}
+	return nil
+}
+
+func resolveRiskSprint(client *jira.Client, now time.Time) (int, error) {
+	// The configured board can be Kanban; Risk sprints belong to scrum board 84.
+	const boardID, pageSize = 84, 50
+	want := "Risk-" + now.Format("200601")
+	var sprintID int
+	for start := 0; ; {
+		page, err := client.Sprints(boardID, "state="+jira.SprintStateActive, start, pageSize)
+		if err != nil {
+			return 0, fmt.Errorf("list active Risk sprints: %w", err)
+		}
+		for _, sprint := range page.Sprints {
+			if sprint.Name == want && sprint.Status == jira.SprintStateActive {
+				if sprintID != 0 && sprintID != sprint.ID {
+					return 0, fmt.Errorf("multiple active sprints named %q", want)
+				}
+				sprintID = sprint.ID
+			}
+		}
+		if page.IsLast {
+			break
+		}
+		next := page.StartAt + len(page.Sprints)
+		if next <= start {
+			return 0, fmt.Errorf("Risk sprint pagination did not advance")
+		}
+		start = next
+	}
+	if sprintID == 0 {
+		return 0, fmt.Errorf("no active sprint named %q on board %d; issue was not created", want, boardID)
+	}
+	return sprintID, nil
+}
